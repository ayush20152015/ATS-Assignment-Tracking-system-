# Copy to .env (or just export these) before running with --brain sarvam.
# Get a key from https://dashboard.sarvam.ai

SARVAM_API_KEY=your-sarvam-api-key

# Optional overrides
# GRADEBOT_STT_MODEL=saaras:v3        # or saaras:v4
# GRADEBOT_VISION_MODEL=gemma4        # image understanding
# GRADEBOT_TEXT_MODEL=sarvam-105b     # rubric parsing + Hindi feedback

# Only for --live
# GRADEBOT_CLASSROOM_CLIENT_SECRET=client_secret.json
# GRADEBOT_CLASSROOM_TOKEN=token.json
